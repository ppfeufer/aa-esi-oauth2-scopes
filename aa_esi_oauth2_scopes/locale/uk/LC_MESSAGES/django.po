#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:12
msgid "ESI OAuth2 Scopes"
msgstr "Компоненти ESI OAuth2"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:12
msgid "and what each scope unlocks"
msgstr "та що кожний розділ розблокує"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:16
#, python-format
msgid ""
"\n"
"                            Parsed live from <a href=\"%(openapi_url)s\" target=\"_blank\" rel=\"noopener\">openapi.json</a>,\n"
"                            requested with an <code>X-Compatibility-Date</code> header (see <a href=\"%(compat_dates_url)s\" target=\"_blank\" rel=\"noopener\">compatibility dates</a>),\n"
"                            switch dates below to see how scopes and endpoints have changed over time.\n"
"                            <br>\n"
"                            Search for a scope name, an endpoint path, or a word from an endpoint's summary to find out which scope you need,\n"
"                            or expand a scope to see every endpoint it unlocks.\n"
"                        "
msgstr ""
"\n"
"                            Розпаршено з <a href=\"%(openapi_url)s\" target=\"_blank\" rel=\"noopener\">openapi.json</a>,\n"
"\n"
"                            запитаного з <code>X-Compatibility-Date</code> заголовка (див <a href=\"%(compat_dates_url)s\" target=\"_blank\" rel=\"noopener\">дати сумісності</a>),\n"
"\n"
"                            перемкніть дати нижче щоб побачити як обмеження та ендпойнти змінились з часом.\n"
"\n"
"                            <br>\n"
"\n"
"                            Шукайте назву розділу, шлях до ендпойнта, або формат слів з результату для пошуку потрібного скоупу,\n"
"\n"
"                            або розверніть скоуп щоб побачити ендпойнти які він розблоковує.\n"
"                        "

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:26
msgid "Loading scopes from ESI…"
msgstr "Завантаження скоупів з ESI…"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:31
msgid "Compatibility date"
msgstr "Дата сумісності"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:32
msgid "Select a compatibility date"
msgstr "Оберіть дату сумісності"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:33
msgid "Select a compatibility date."
msgstr "Оберіть дату сумісності."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:37
msgid "Search"
msgstr "Пошук"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:42
msgid "Search…"
msgstr "Пошук…"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:45
msgid "Search scopes or endpoints (e.g. \"assets\", \"mail\", \"GetCharactersCharacterIdAssets\")."
msgstr "Оберіть скоупи або ендпойнти (такі як \"assets\", \"mail\", \"GetCharactersCharacterIdAssets\")."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:64
msgid "No endpoints currently require this scope."
msgstr "Нема ендпойнтів у цьому скоупі."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:65
#, python-format
msgid "%%(current_scopes_length)s scopes covering %%(total_endpoints)s endpoints, for compatibility date %%(date)s"
msgstr "%%(current_scopes_length)s скоупи покривають %%(total_endpoints)s ендпойнтів, для дати сумісності %%(date)s"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:66
#, python-format
msgid "Showing %%(number)s of %%(total)s scopes."
msgstr "Показано %%(number)s з %%(total)s скоупів."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:67
#, python-format
msgid "No scopes or endpoints match \"%%(query)s\"."
msgstr "Нема скоупів або ендпойнтів що відповідають запиту пошуку \"%%(query)s\"."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:68
#, python-format
msgid "Could not load the ESI OpenAPI specs (%%(textstatus)s). Try reloading the page."
msgstr "НЕ вдалось завантажити специфікацію ESI OpenAPI (%%(textstatus)s). Спробуйте перезавантажити сторінку."

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:69
#, python-format
msgid "Loading scopes for compatibility date %%(date)s…"
msgstr "Завантаження скоупів для дати сумісності date %%(date)s…"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:70
#, python-format
msgid "Failed to load OpenAPI specs: %%(status)s %%(statustext)s"
msgstr "Невчача завантаження специфікації OpenAPI: %%(status)s %%(statustext)s"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:71
#, python-format
msgid "Failed to load compatibility dates: %%(status)s %%(statustext)s"
msgstr "Невдача завантаження дат сумісності: %%(status)s %%(statustext)s"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:72
msgid "No compatibility dates returned!"
msgstr "Не повернуто дат сумісності!"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:73
msgid "most recent"
msgstr "нещодавнє"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:74
#, python-format
msgid "%%(count)s endpoint"
msgstr "%%(count)s ендпойнтів"

#: aa_esi_oauth2_scopes/templates/aa_esi_oauth2_scopes/index.html:75
#, python-format
msgid "%%(count)s endpoints"
msgstr "%%(count)s ендпойнти"
